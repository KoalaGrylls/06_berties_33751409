<!doctype html>
<html>
  <head>
    <title> <%=shopData.shopName%></title>
    <link rel="stylesheet"  type="text/css" href="/main.css" />
  </head>
  <body>
    <h1>Login to <%=shopData.shopName%></h1>
    <form method="POST" action="/users/loggedin">
        <p> Username: <input id="username" type="text" name="username" /></p>
        <p>Password: <input id="password" type="password" name="password" /></p>
        <input type="submit" value="Login" />
      </form>

      <% if (error) { %>
      <p style="color:red;"><%= error %></p>
      <% } %>
  </body>
</html>